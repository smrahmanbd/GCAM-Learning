<!--
  carbon_price_global.xml
  Used by: lab 10 (the CarbonPrice scenario). Listed as the last scenario
  component in config_carbonprice.xml.

  What it is: one global carbon price on fossil and industrial CO2. All 32
  regions share one market called "global", so they face the same price.
  The price starts in 2025 and rises 5 percent a year. Units are 1990 US
  dollars per tonne of carbon (GCAM documentation, policy examples page).

  Where it comes from: the layout and the price path are copied from
  input/policy/carbon_tax_25_5.xml in gcam-core at tag gcam-v9.1. One thing
  is changed: the policy is named CO2 instead of CO2_LTG, so the price acts
  on CO2 emissions directly without the extra link files that the release
  uses for its own policy runs. This follows the carbon price example in
  the GCAM documentation (ghgpolicy name="CO2" with fixedTax).

  MUST BE CHECKED against the installed GCAM release: region names must
  match the release, and one test run must show a market with CO2 in its
  name in the "CO2 prices" query. This file has not been run.
  Land-use CO2 is not priced by this file.
-->
<scenario>
	<world>
		<region name="USA">
			<ghgpolicy name="CO2">
				<market>global</market>
                <fixedTax year="2025">25</fixedTax>
                <fixedTax year="2030">31.9070390625</fixedTax>
                <fixedTax year="2035">40.722365669436</fixedTax>
                <fixedTax year="2040">51.9732044852842</fixedTax>
                <fixedTax year="2045">66.3324426286105</fixedTax>
                <fixedTax year="2050">84.6588735224847</fixedTax>
